{
  "name": "lsa-heat-intelligence",
  "version": "1.0.0",
  "description": "L'SA — standalone Android heat intelligence app",
  "type": "module",
  "scripts": {
    "build:web": "vite build",
    "sync": "npm run build:web && npx cap sync android",
    "open:android": "npx cap open android",
    "build:android": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor-community/text-to-speech": "5.1.0",
    "@capawesome-team/capacitor-android-foreground-service": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
